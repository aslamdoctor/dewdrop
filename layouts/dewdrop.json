{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "titlebar",
      "type": "block",
      "size": { "px": 40 },
      "window_drag": true,
      "content": { "mod": "dewdrop", "props": { "role": "titlebar" } }
    },
    {
      "id": "valley",
      "type": "column",
      "background": { "image": "mods/dewdrop/art/scene/day-460.png", "fit": "cover" },
      "children": [
        {
          "id": "sky",
          "type": "block",
          "size": { "px": 48 },
          "content": { "mod": "dewdrop", "props": { "role": "sky" } }
        },
        {
          "id": "main",
          "type": "block",
          "padding": [16, 16],
          "content": {
            "tab": "active",
            "pane": {
              "gap": 10,
              "radius": 0,
              "background": "#20160fdb",
              "border": { "width": 3, "color": "#6b4420" },
              "focus": { "width": 3, "color": "#f2c14e" },
              "lone": true,
              "header": {
                "content": { "mod": "dewdrop", "props": { "role": "header" } },
                "height": 28,
                "position": "top",
                "reveal": "always"
              }
            }
          }
        },
        {
          "id": "peek-spacer",
          "type": "block",
          "hidden": true,
          "content": { "mod": "dewdrop", "props": { "role": "empty" } }
        },
        {
          "id": "hotbar",
          "type": "block",
          "size": { "px": 64 },
          "content": { "mod": "dewdrop", "props": { "role": "hotbar" } }
        }
      ]
    }
  ],
  "theme": "dewdrop",
  "font": "Geist Mono",
  "font_size": 14,
  "ui_font": "Pixelify Sans",
  "terminal_padding": [8, 4],
  "terminal_opacity": 0,
  "background": "#2b1d14",
  "titlebar": "none",
  "traffic_lights": [14, 11]
}
