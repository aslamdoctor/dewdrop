{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "titlebar",
      "type": "block",
      "size": {
        "px": 40
      },
      "window_drag": true,
      "content": {
        "mod": "dewdrop",
        "props": {
          "role": "titlebar"
        }
      }
    },
    {
      "id": "main",
      "type": "block",
      "padding": [
        16,
        16
      ],
      "background": {
        "image": "mods/dewdrop/art/farm.png",
        "fit": "cover"
      },
      "content": {
        "tab": "active",
        "pane": {
          "gap": 10,
          "radius": 0,
          "background": "#2b1d14",
          "border": {
            "width": 3,
            "color": "#8a5a2b"
          },
          "focus": {
            "width": 3,
            "color": "#c58b4e"
          },
          "lone": true,
          "header": {
            "content": {
              "mod": "dewdrop",
              "props": {
                "role": "header"
              }
            },
            "height": 26,
            "position": "top",
            "reveal": "always"
          }
        }
      },
      "floating": [
        {
          "id": "chicken",
          "content": {
            "mod": "dewdrop",
            "props": {
              "role": "chicken"
            }
          },
          "edge": "right",
          "align": "end"
        }
      ]
    },
    {
      "id": "hotbar",
      "type": "block",
      "size": {
        "px": 64
      },
      "content": {
        "mod": "dewdrop",
        "props": {
          "role": "hotbar"
        }
      },
      "background": {
        "image": "mods/dewdrop/art/hotbar-field.png",
        "fit": "cover"
      }
    }
  ],
  "theme": "dewdrop",
  "font": "Geist Mono",
  "font_size": 14,
  "ui_font": "Pixelify Sans",
  "terminal_padding": [
    8,
    4
  ],
  "terminal_opacity": 1,
  "background": "#2b1d14",
  "titlebar": "none",
  "traffic_lights": [
    14,
    11
  ]
}
